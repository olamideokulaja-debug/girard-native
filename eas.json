{
  "cli": { "version": ">= 5.9.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "image": "latest", "simulator": false, "credentialsSource": "remote" },
      "android": { "buildType": "apk", "image": "latest" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": { "image": "latest", "credentialsSource": "remote" },
      "android": { "image": "latest" }
    }
  },
  "submit": { "production": {} }
}
